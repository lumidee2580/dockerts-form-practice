# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.

# ----------------------------------------------------------------- Backend --
# SQLite is stored in the backend's persistent Compose volume.
DATABASE_URL=sqlite:////data/biodata.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
BACKEND_HOST_PORT=8000

# ---------------------------------------------------------------- Frontend --
# Server-side only; the browser never talks to the backend directly.
BACKEND_URL=http://backend:8000
# Local dev without Docker:
# BACKEND_URL=http://localhost:8000
FRONTEND_HOST_PORT=3000

# --------------------------------------------------------------------- CI ---
# Used by the backend test suite in CI / locally.
TEST_DATABASE_URL=sqlite:////tmp/biodata_test.db
